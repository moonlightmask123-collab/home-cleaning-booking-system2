# Copy this file to ".env" and fill it in. Never share or upload your real .env.

# --- Database (local MySQL / XAMPP defaults shown) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=home_cleaning
# Online hosts usually give ONE link instead - if you have it, use this and ignore the DB_* lines above:
# DATABASE_URL=mysql://user:password@host:3306/dbname
# Cloud MySQL usually needs SSL:
# DB_SSL=true

# --- Security (required when the site is online) ---
# Any long random text. Keeps logins valid across server restarts.
AUTH_SECRET=change-me-to-a-long-random-text
# Password for /admin.html (owner panel). Leave empty to switch the admin panel off.
ADMIN_PASSWORD=change-this-admin-password

# --- Business settings ---
SLOT_CAPACITY=3
# PORT=3000
